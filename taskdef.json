{
    "family": "taskdef-back",
    "taskRoleArn": "arn:aws:iam::481665114569:role/task-executionRole",
    "executionRoleArn": "arn:aws:iam::481665114569:role/task-executionRole",
    "networkMode": "bridge",
    "containerDefinitions": [
        {
            "name": "backend-con",
            "image": "<IMAGE1_NAME>",
            "cpu": 512,
            "memory": 2048,
            "memoryReservation": 1536,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 0,
                    "protocol": "tcp",
                    "name": "backend-port",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "SPRING_DATASOURCE_USERNAME",
                    "value": "admin"
                },
                {
                    "name": "SPRING_DATASOURCE_URL",
                    "value": "jdbc:mysql://database-1.cbsamyg46pqs.ap-northeast-2.rds.amazonaws.com:3306/demodb"
                },
                {
                    "name": "SPRING_DATASOURCE_PASSWORD",
                    "value": "test1234"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/taskdef-back",
                    "awslogs-create-group": "true",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ],
    "requiresCompatibilities": ["EC2"],
    "cpu": "1024",
    "memory": "3072"
}
